# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Public URL PayPal can reach (Render URL, or a cloudflared tunnel in dev)
PUBLIC_BASE_URL=http://localhost:8787

# Postgres connection string. Leave unset to use embedded PGlite.
# DATABASE_URL=
# PGlite and capture-pool paths on a Render persistent disk (leave unset locally).
# PGLITE_DIR=/var/data/pglite
# CAPTURE_POOL_PATH=/var/data/capture-pool.json

# Optional Render Workflows (set slug and callback URL after deploy; Blueprint shares token).
# RENDER_API_KEY=
# RENDER_WORKFLOW_SLUG=
# WORKFLOW_CALLBACK_TOKEN=
# SHOPCREW_BASE_URL=https://your-service.onrender.com

# LLM. Default replay needs no key and is the demo-safe path.
LLM_PROVIDER=replay
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=groq
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# LLM_RECORD=1

# AG Grid / AG Studio licence keys. Served at runtime from /api/config.
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=

# AG Studio AI assistant (OpenAI Responses API). Prefer AG_STUDIO_OPENAI_API_KEY.
# Without a key, Insights still works — the AI panel is simply omitted.
# AG_STUDIO_OPENAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1

DEMO_SEED=42
ADMIN_TOKEN=shopcrew-demo
SUPPLIER_EMAILS=acme-supplies@personal.example.com
# Real-looking email with NO sandbox account (do not use @shopcrew.test).
# Dry-run payouts only when PayPal is unconfigured — not by email domain.
UNCLAIMED_SUPPLIER_EMAIL=unclaimed-supplier@shopcrew.example
# Studio AI proxy limits (P3.2)
# STUDIO_AI_RATE_PER_MIN=20
# STUDIO_AI_DAILY_CAP=500000
DEMO_BUYER_EMAIL=
DEMO_BUYER_HINT=Use the sandbox personal account "Buyer Bob" from developer.paypal.com
# Optional initial capture-pool import, used only if the mutable pool file does not exist.
# CAPTURE_POOL_JSON=
PORT=8787

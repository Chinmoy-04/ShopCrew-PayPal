# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Public URL PayPal can reach (Render URL, or a cloudflared tunnel in dev)
PUBLIC_BASE_URL=http://localhost:8787

# Postgres connection string. Leave unset to use embedded PGlite.
# DATABASE_URL=

# LLM. Default replay needs no key and is the demo-safe path.
LLM_PROVIDER=replay
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=groq
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# LLM_RECORD=1

# AG Grid / AG Studio licence keys. Served at runtime from /api/config.
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=

# AG Studio AI assistant (OpenAI Responses API). Prefer AG_STUDIO_OPENAI_API_KEY.
# Without a key, Insights still works — the AI panel is simply omitted.
# AG_STUDIO_OPENAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1

DEMO_SEED=42
ADMIN_TOKEN=shopcrew-demo
SUPPLIER_EMAILS=acme-supplies@personal.example.com
UNCLAIMED_SUPPLIER_EMAIL=unclaimed-supplier@shopcrew.test
PORT=8787
